# ==========================================
# TaskPad SaaS - Environment Configuration
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# Clerk Authentication
# ------------------------------------------
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------
# Supabase Database & Storage
# ------------------------------------------
# Get these from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Connection String (for direct migrations/pooling if using Prisma or pg)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ------------------------------------------
# Web Push Notifications (VAPID)
# ------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckj0bMW30ddEHKbaa6vnv94B1U0_qs
VAPID_PRIVATE_KEY=AVff6_1kU9O79R9n7vYp1zR01mZ-U40N9f2YvK6y9vU
VAPID_SUBJECT=mailto:notifications@taskpad.app

# ------------------------------------------
# Email Service (Nodemailer / Transactional)
# ------------------------------------------
EMAIL_FROM=TaskPad Reminders <notifications@taskpad.app>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional Resend API Key (if preferred over SMTP)
RESEND_API_KEY=

# ------------------------------------------
# Scheduler / Cron Security Token
# ------------------------------------------
CRON_SECRET=taskpad_secure_cron_worker_secret_key_2026
